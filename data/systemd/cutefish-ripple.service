[Unit]
Description=Cutefish Ripple — nearby file sharing
Documentation=https://github.com/cutefishos/cutefish-compositor
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/cutefish-ripple
Restart=on-failure
RestartSec=3
# A receiver has to be listening whether or not the panel is open.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
